CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Formulaire de contact (functions/api/contact.js → Resend).
# Sans RESEND_API_KEY, le formulaire renvoie une erreur explicite : il n'envoie rien.
